{
  "index_patterns": [
    ".wazuh-cases-v1"
  ],
  "priority": 100,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "auto_expand_replicas": "0-1",
        "refresh_interval": "5s",
        "hidden": true
      }
    },
    "mappings": {
      "dynamic": "strict",
      "date_detection": false,
      "properties": {
        "id": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "title": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "description": {
          "type": "text"
        },
        "status": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "severity": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "priority": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "tlp": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "owner": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "created_by": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "updated_by": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "created_at": {
          "type": "date",
          "format": "strict_date_time"
        },
        "updated_at": {
          "type": "date",
          "format": "strict_date_time"
        },
        "first_assigned_at": {
          "type": "date",
          "format": "strict_date_time"
        },
        "triage_started_at": {
          "type": "date",
          "format": "strict_date_time"
        },
        "activated_at": {
          "type": "date",
          "format": "strict_date_time"
        },
        "closed_at": {
          "type": "date",
          "format": "strict_date_time"
        },
        "first_closed_at": {
          "type": "date",
          "format": "strict_date_time"
        },
        "reopened_at": {
          "type": "date",
          "format": "strict_date_time"
        },
        "revision": {
          "type": "integer"
        },
        "closure": {
          "dynamic": "strict",
          "properties": {
            "classification": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "reason": {
              "type": "text"
            },
            "closed_by": {
              "type": "keyword",
              "ignore_above": 1024
            }
          }
        },
        "pending_activity": {
          "dynamic": "strict",
          "properties": {
            "id": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "incident_id": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "revision": {
              "type": "integer"
            },
            "kind": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "actor": {
              "type": "keyword",
              "ignore_above": 1024
            },
            "at": {
              "type": "date",
              "format": "strict_date_time"
            },
            "changes": {
              "type": "object",
              "enabled": false
            }
          }
        },
        "findings": {
          "type": "nested",
          "dynamic": "strict",
          "properties": {
            "index": {
              "type": "keyword",
              "ignore_above": 255
            },
            "document_id": {
              "type": "keyword",
              "ignore_above": 512
            }
          }
        },
        "finding_count": {
          "type": "integer"
        },
        "create_request_hash": {
          "type": "keyword",
          "index": false,
          "doc_values": false
        },
        "tasks": {
          "type": "object",
          "enabled": false
        },
        "correlation_origin": {
          "type": "object",
          "enabled": false
        },
        "response_requests": {
          "type": "object",
          "enabled": false
        },
        "playbook_runs": {
          "type": "object",
          "enabled": false
        },
        "ai_feedback_ids": {
          "type": "keyword",
          "index": false,
          "doc_values": false
        },
        "handover": {
          "type": "object",
          "dynamic": "strict",
          "properties": {
            "target": { "type": "keyword", "ignore_above": 1024 },
            "offered_by": { "type": "keyword", "index": false, "doc_values": false },
            "offered_at": { "type": "date", "format": "strict_date_time", "index": false, "doc_values": false }
          }
        },
        "tuning_proposals": {
          "type": "object",
          "enabled": false
        }
      }
    }
  }
}
