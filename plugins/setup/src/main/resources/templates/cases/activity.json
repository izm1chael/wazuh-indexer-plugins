{
  "index_patterns": [
    ".wazuh-case-activity-v1"
  ],
  "priority": 100,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "auto_expand_replicas": "0-1",
        "refresh_interval": "5s",
        "hidden": true
      }
    },
    "mappings": {
      "dynamic": "strict",
      "date_detection": false,
      "properties": {
        "id": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "incident_id": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "revision": {
          "type": "integer"
        },
        "kind": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "actor": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "at": {
          "type": "date",
          "format": "strict_date_time"
        },
        "changes": {
          "type": "object",
          "enabled": false
        }
      }
    }
  }
}
