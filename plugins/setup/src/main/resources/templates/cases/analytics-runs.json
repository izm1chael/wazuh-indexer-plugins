{
  "index_patterns": [
    ".wazuh-analytics-runs-v1"
  ],
  "priority": 100,
  "template": {
    "settings": {
      "index": {
        "number_of_shards": 1,
        "auto_expand_replicas": "0-1",
        "refresh_interval": "5s",
        "hidden": true
      }
    },
    "mappings": {
      "dynamic": "strict",
      "date_detection": false,
      "properties": {
        "id": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "deployment_id": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "policy_id": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "actor": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "plan_sha256": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "state": {
          "type": "keyword",
          "ignore_above": 1024
        },
        "policy_version": {
          "type": "integer"
        },
        "finding_count": {
          "type": "integer"
        },
        "group_count": {
          "type": "integer"
        },
        "below_threshold": {
          "type": "integer"
        },
        "from": {
          "type": "date",
          "format": "strict_date_optional_time"
        },
        "until": {
          "type": "date",
          "format": "strict_date_optional_time"
        },
        "recorded_at": {
          "type": "date",
          "format": "strict_date_optional_time"
        }
      }
    }
  }
}
